# URL de la API (GET) de la cual se obtienen las órdenes.
API_GET_URL=

# Ruta destino (POST) a la cual se envía cada orden. (Pendiente de definir)
API_POST_URL=

# Token de autenticación (opcional). Si está vacío no se envía cabecera Authorization.
API_TOKEN=

# Horarios de ejecución (HH:MM separadas por coma). Lunes a viernes y sábado.
HORARIOS_SEMANA=10:00,16:00
HORARIOS_SABADO=10:00

# Configuración SMTP para el correo con el listado completo.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ORIGEN=
# Destinatarios del correo, separados por coma (puede ser uno o más).
EMAIL_DESTINO=desarrollo@gmail.com

# Timeout en segundos para cada petición HTTP.
TIMEOUT_SEGUNDOS=30

# Número máximo de reintentos por petición ante errores de red o HTTP 5xx/429.
MAX_REINTENTOS=3

# true/false: ejecuta un procesamiento inmediato al iniciar el bot.
EJECUTAR_AL_INICIAR=false
