# =============================================================================
# CONFIGURACIÓN GLOBAL (compartida por todos los módulos)
# =============================================================================

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SMTP para envío de correos
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ORIGEN=
# Destinatarios por defecto (separados por coma)
EMAIL_DESTINO=desarrollo@gmail.com

# HTTP genérico (timeout y reintentos aplican a todos los módulos)
TIMEOUT_SEGUNDOS=30
MAX_REINTENTOS=3

# true/false: ejecuta todos los módulos inmediatamente al iniciar el bot.
EJECUTAR_AL_INICIAR=false

# =============================================================================
# MÓDULO: ordenes_sin_levante
# Todas sus variables usan el prefijo LEVANTE_
# =============================================================================

# URLs y autenticación
LEVANTE_API_GET_URL=
LEVANTE_API_POST_URL=
LEVANTE_API_TOKEN=

# Título del mensaje enviado por la API
LEVANTE_TITULO_MENSAJE=PRUEBA DE SISTEMAS - ORDENES DE DEPOSITO SIN LEVANTE AUTORIZADO (NO SE ENCUENTRAN LEGAJADAS O EN ABANDONO LEGAL)

# ID de usuario emisor (lo consume la API POST)
LEVANTE_USER_ID=1
# IDs adicionales para notificar al jefe (separados por coma)
LEVANTE_USUARIOS_ADICIONALES_JEFE=

# Horarios de ejecución (HH:MM separadas por coma)
LEVANTE_HORARIOS_SEMANA=10:00,16:00
LEVANTE_HORARIOS_SABADO=10:00
LEVANTE_HORARIOS_DOMINGO=

# Control de envío de correo por horario (T=envía, F=no envía).
# Se mapea posicionalmente con HORARIOS_SEMANA/SABADO/DOMINGO.
LEVANTE_HORARIOS_CORREO=T,F
LEVANTE_HORARIOS_CORREO_SABADO=T
LEVANTE_HORARIOS_CORREO_DOMINGO=
